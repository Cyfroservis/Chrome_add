{
  "manifest_version": 3,
  "name": "Виправлення розкладки",
  "version": "0.1.7",
  "description": "Підказує перетворити текст, набраний не в тій розкладці клавіатури. Цифросервіс, Сивак М. В.",
  "minimum_chrome_version": "109",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Виправлення розкладки: налаштування",
    "default_popup": "options.html"
  },
  "commands": {
    "convert-selection": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Перетворити виділений текст на правильну розкладку"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["layouts.js", "detect.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
